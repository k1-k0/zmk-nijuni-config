#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define TTMS       200
#define QTMS       175
#define RPIDMS     175
#define CH_RPI_MS  150
#define CV_RPI_MS  50

#define RHYPER  RS(RA(RC(RGUI)))
#define LHYPER  LS(LA(LC(LGUI)))
#define MSHFT &mshft RSHFT 0
#define LNG F18

&lt {
    tapping-term-ms = <TTMS>;
    quick-tap-ms = <QTMS>;
};

/ {
    behaviors {
        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <TTMS>;
            quick-tap-ms = <QTMS>;
            require-prior-idle-ms = <RPIDMS>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        hrmr: hrmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <TTMS>;
            quick-tap-ms = <QTMS>;
            require-prior-idle-ms = <RPIDMS>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        mshftm: magic_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk RSHFT>, <&caps_word>;
            mods = <(MOD_RSFT)>;
        };

        mshft: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mshftm>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <RPIDMS>;
        };
    };

    app_swap: app_swapper {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;

        ignored-key-positions = <2 16 17 18 19>;
    };

    appw_swap: app_win_swapper {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LGUI>, <&kp GRAVE>, <&kt LGUI>;

        ignored-key-positions = <22 16 17 18 19>;
    };

    tbbr: tabber {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LCTRL>, <&kp TAB>, <&kt LCTRL>;

        ignored-key-positions = <6 16 17 18 19>;
    };

    combos {
        compatible = "zmk,combos";

        rlng {
            bindings = <&kp LNG>;
            key-positions = <14 15>;
            timeout-ms = <24>;
            require-prior-idle-ms = <CH_RPI_MS>;
        };

        llng {
            bindings = <&kp LNG>;
            key-positions = <20 21>;
            timeout-ms = <24>;
            require-prior-idle-ms = <CH_RPI_MS>;
        };

        rbslh {
            bindings = <&kp BSLH>;
            key-positions = <15 16>;
            timeout-ms = <24>;
            require-prior-idle-ms = <CH_RPI_MS>;
        };

        lbslh {
            bindings = <&kp BSLH>;
            key-positions = <19 20>;
            timeout-ms = <24>;
            require-prior-idle-ms = <CH_RPI_MS>;
        };

        lhyper {
            bindings = <&kp LHYPER>;
            key-positions = <15 17>;
            timeout-ms = <30>;
            require-prior-idle-ms = <CH_RPI_MS>;
        };

        rhyper {
            bindings = <&kp RHYPER>;
            key-positions = <18 20>;
            timeout-ms = <30>;
            require-prior-idle-ms = <CH_RPI_MS>;
        };

        ldhyper {
            bindings = <&kp LHYPER>;
            key-positions = <15 28>;
            timeout-ms = <30>;
            require-prior-idle-ms = <CV_RPI_MS>;
        };

        rdhyper {
            bindings = <&kp RHYPER>;
            key-positions = <20 31>;
            timeout-ms = <30>;
            require-prior-idle-ms = <CV_RPI_MS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwe {
            bindings = <
&kp RBKT   &kp Q         &kp W         &kp E          &kp R          &kp T                                      &kp Y     &kp U          &kp I          &kp O         &kp P            &kp LBKT  // 11
&kp GRAVE  &hrml LGUI A  &hrml LALT S  &hrml LCTRL D  &hrml LSHFT F  &kp G                                      &kp H     &hrmr RSHFT J  &hrmr RCTRL K  &hrmr RALT L  &hrmr RGUI SEMI  &kp APOS  // 23
&kp MINUS  &kp Z         &kp X         &kp C          &kp V          &kp B                                      &kp N     &kp M          &kp COMMA      &kp DOT       &kp FSLH         &kp EQUAL // 35
                                                      &lt 3 TAB      &lt 1 SPACE    &lt 4 ENTER     &lt 2 ESC   MSHFT     &lt 3 BSPC
            >;
        };

        nav {
            bindings = <
&kp KP_NUMLOCK  &sk LHYPER   &kp ESC     &kp LS(TAB)    &app_swap  &kp CAPS                              &kp HOME    &kp PG_DN          &kp PG_UP       &kp END           &kp PSCRN       &kp INS
&kp COMMA       &sk LGUI     &sk LALT    &sk LCTRL      &sk LSHFT  &caps_word                            &kp LEFT    &hrmr RSHIFT DOWN  &hrmr RCTRL UP  &hrmr RALT RIGHT  &hrmr RGUI ESC  &kp RG(TAB)
&kp DOT         &kp LS(TAB)  &tbbr       &kp LS(GRAVE)  &appw_swap &kp ENTER                             &kp ENTER   &kp TAB            &kp BSPC        &kp DEL           &kp K_APP       &key_repeat
                                                        &trans     &trans       &trans       &trans      &trans      &trans
            >;
        };

        num {
            bindings = < 
&kp KP_NUMLOCK  &kp KP_DIVIDE     &kp N7             &kp N8          &kp N9          &kp PLUS                              &kp KP_NUMLOCK  &kp LPAR              &kp RPAR              &kp CARET               &kp ENTER              &trans
&kp COMMA       &lpht LCMD N0     &lpht LEFT_ALT N4  &lpht LCTRL N5  &lpht LSHFT N6  &kp MINUS                             &kp KP_EQUAL    &rpht RSHFT KP_MINUS  &rpht RCTRL KP_PLUS   &rpht RALT KP_MULTIPLY  &rpht RGUI KP_DIVIDE   &trans
&kp DOT         &kp KP_ASTERISK   &kp N1             &kp N2          &kp N3          &kp EQUAL                             &trans          &trans                &kp KP_COMMA          &kp KP_DOT              &trans                 &trans
                                                                     &trans          &trans        &trans      &trans      &trans          &trans
            >;
        };

        sym {
            bindings = <
&kp BSLH   &kp FSLH          &kp AMPS         &kp STAR           &kp LPAR           &kp PLUS                            &kp TILDE  &kp EQUAL          &kp BSLH          &kp PIPE         &kp GRAVE       &kp QMARK
&kp COMMA  &hrml LGUI RPAR   &hrml LALT DLLR  &hrml LCTRL PRCNT  &hrml LSHFT CARET  &kp MINUS                           &kp MINUS  &hrmr RSHIFT LPAR  &hrmr RCTRL LBKT  &hrmr RALT LBRC  &hrmr RGUI SQT  &kp LT
&kp DOT    &kp ASTRK         &kp EXCL         &kp AT             &kp HASH           &kp EQUAL                           &kp UNDER  &kp RPAR           &kp RBKT          &kp RBRC         &kp DQT         &kp GT
                                                                 &trans             &trans       &trans      &trans     &trans     &trans
            >;
        };

        fun {
            bindings = <
&trans    &kp PAUSE_BREAK   &kp F7         &kp F8          &kp F9          &kp F10                        &kp C_RW      &kp C_BRI_DN           &kp C_BRI_UP          &kp C_FF           &kp PAUSE_BREAK   &trans
&kp INS   &hrml LGUI PSCRN  &hrml LALT F4  &hrml LCTRL F5  &hrml LSHFT F6  &kp F11                        &kp C_PREV    &hrmr RSHFT C_VOL_DN   &hrmr RCTRL C_VOL_UP  &hrmr RALT C_NEXT  &hrmr RGUI PSCRN  &kp INS
&trans    &kp LNG           &kp F1         &kp F2          &kp F3          &kp F12                        &key_repeat   &kp PSCRN              &kp C_MUTE            &kp C_PP           &kp LNG           &trans
                                                           &trans          &trans    &trans     &trans    &trans        &trans
            >;
        };

        ble {
            bindings = <
&trans     &bootloader     &sys_reset  &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1                    &bt BT_SEL 1  &bt BT_SEL 0  &out OUT_BLE  &sys_reset  &bootloader    &trans
&trans     &trans          &bt BT_CLR  &out OUT_TOG  &trans        &bt BT_SEL 2                    &bt BT_SEL 2  &trans        &out OUT_TOG  &bt BT_CLR  &trans         &trans
&trans     &bt BT_CLR_ALL  &trans      &out OUT_USB  &bt BT_SEL 4  &bt BT_SEL 3                    &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_USB  &trans      &bt BT_CLR_ALL &trans
                                                     &trans        &trans        &trans    &trans  &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        to_ble {
            if-layers = <2 4>;
            then-layer = <5>;
        };
    }; 
};
